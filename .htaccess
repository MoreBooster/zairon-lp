<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization"
</IfModule>

# Normalize shared terms URLs and serve the landing page language URL.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Keep an explicitly requested language; otherwise use the language prefix.
    RewriteCond %{QUERY_STRING} !(^|&)lang= [NC]
    RewriteRule ^(pt-br|pt|en|en-us|es)/terms-of-use(?:\.html)?/?$ /terms-of-use.html?lang=$1 [R=302,L,QSA,NC]
    RewriteRule ^(?:pt-br|pt|en|en-us|es)/terms-of-use(?:\.html)?/?$ /terms-of-use.html [R=302,L,NC]
    RewriteRule ^terms-of-use(?:/|\.html/)?$ /terms-of-use.html [R=302,L,NC]
    RewriteRule ^pt-br/$ /pt-br [R=302,L]
    RewriteRule ^pt-br$ index.html [L]
</IfModule>

# Revalidate documents and navigation scripts after deployments.
<FilesMatch "^(index\.html|terms-of-use\.html|script\.js|terms\.js)$">
    <IfModule mod_expires.c>
        ExpiresActive Off
    </IfModule>
    <IfModule mod_headers.c>
        Header onsuccess unset Cache-Control
        Header always set Cache-Control "no-cache, max-age=0, must-revalidate"
        Header onsuccess unset Expires
        Header always unset Expires
    </IfModule>
</FilesMatch>
